# --- LLM gateway (Azure API Management in front of Azure OpenAI) ---
APIM_BASE_URL=https://apim-genai-tech-test.azure-api.net/c/<slug>
APIM_SUBSCRIPTION_KEY=changeme
CHAT_DEPLOYMENT=gpt-5

# --- Embeddings: "local" (offline, multilingual-e5-large) or "azure" ---
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=1024
# Only for EMBEDDING_PROVIDER=azure
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBED_DEPLOYMENT=text-embedding-3-small

# --- Storage ---
DATABASE_URL=postgresql://cvsearch:cvsearch@localhost:5432/cvsearch

# --- Access control (leave empty only for local development) ---
CVSEARCH_API_KEY=dev-api-key
CVSEARCH_UI_PASSWORD=dev-password
CVSEARCH_API_URL=http://localhost:8000
